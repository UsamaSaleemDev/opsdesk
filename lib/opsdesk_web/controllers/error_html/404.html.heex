<Layouts.app flash={assigns[:flash] || %{}} current_scope={assigns[:current_scope]}>
  <section class="hero bg-base-200 rounded-box">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <p class="text-sm font-semibold tracking-wide uppercase">404</p>

        <h1 class="text-4xl font-bold mt-2">Page not found</h1>

        <p class="py-6 text-base-content/70">
          That URL does not exist. Check the address or go back to the home page.
        </p>
        <.link href={~p"/"} class="btn btn-primary">Back home</.link>
      </div>
    </div>
  </section>
</Layouts.app>
